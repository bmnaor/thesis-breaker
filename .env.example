# Thesis Breaker runtime configuration. Copy to .env and fill. Never commit .env.

# Mode: SAMPLE uses frozen fixtures only, no network, no keys. LIVE calls real APIs.
MODE=SAMPLE

# Nebius Token Factory (OpenAI-compatible). Required in LIVE mode only.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
MODEL_EXTRACTOR=
MODEL_JUDGE=
MODEL_COMPOSER=

# Tavily search/extract. Optional; required only for the reporting connector.
TAVILY_API_KEY=

# Zetaris AI Data Gateway (local Docker). Optional; used for the SQL evidence-mart path.
ZETARIS_BASE_URL=http://localhost:8888
ZETARIS_API_KEY=

# Where the H-MEM memory spine persists between runs.
MEMORY_DIR=.thesis-breaker
